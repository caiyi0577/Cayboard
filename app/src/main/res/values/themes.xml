<resources>
    <!-- Base application theme. -->
    <style name="Theme.Xime" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#356B97</item>
        <item name="colorPrimaryVariant">#285B83</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#356B97</item>
        <item name="colorSecondaryVariant">#285B83</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorAccent">#356B97</item>
        <item name="android:colorAccent">#356B97</item>
        <item name="android:textColorHighlight">#66356B97</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <!-- 整屏字幕页：没有标题栏，页面自己画所有内容。 -->
    <style name="Theme.Xime.Caption" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>